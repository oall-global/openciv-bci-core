<view class="share">
  <view wx:if="{{!usable}}" class="empty">
    <text class="sub">这段录制里还没有可用的脑电数据（需要先完成初始化并建立基线）。</text>
    <button class="primary" bindtap="close">关闭</button>
  </view>

  <!-- 脑电记录: the words on the card -->
  <view wx:elif="{{!made}}" class="form">
    <text class="h1">脑电记录</text>
    <text class="label">标题</text>
    <input class="field" maxlength="20" value="{{title}}" bindinput="onTitle" />
    <text class="label">备注（可选）</text>
    <input class="field" maxlength="40" value="{{note}}" bindinput="onNote" />
    <block wx:if="{{marks.length}}">
      <text class="label">标记的时刻</text>
      <view wx:for="{{marks}}" wx:key="t" class="mark">
        <text class="mono dim">{{item.at}}</text>
        <input class="field small" maxlength="8" value="{{item.label}}" data-i="{{index}}" bindinput="onMark" />
      </view>
    </block>
    <text class="label">署名（可选）</text>
    <input class="field" maxlength="16" value="{{sign}}" bindinput="onSign" />
    <button class="primary" bindtap="make">生成卡片</button>
  </view>

  <!-- the card: to keep, take a screenshot -->
  <block wx:else>
    <canvas type="2d" id="card" class="card-canvas" />
    <view class="acts">
      <text class="link" bindtap="edit">修改文字</text>
      <text class="link" bindtap="close">完成</text>
    </view>
  </block>
</view>
