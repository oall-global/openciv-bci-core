.wrap {
  padding: 24rpx;
}
.card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1px solid #23302b;
  border-radius: 20rpx;
  background: #111715;
}
.h {
  display: block;
  margin-bottom: 16rpx;
  color: #93a19a;
  font-size: 26rpx;
}
.field {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border: 1px solid #23302b;
  border-radius: 12rpx;
  background: #0a0d0c;
  color: #e6ebe8;
}
.btn {
  background: #18221f;
  color: #e6ebe8;
  font-size: 28rpx;
}
.btn.primary {
  background: #23806f;
  color: #fff;
}
.status {
  margin: 8rpx 4rpx 16rpx;
  color: #93a19a;
  font-size: 24rpx;
}
.error {
  margin: 0 4rpx 24rpx;
  color: #ef7e66;
  font-size: 26rpx;
}
.stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.stats view {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.n {
  font-size: 40rpx;
  font-family: Menlo, monospace;
}
.l {
  color: #93a19a;
  font-size: 22rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.ch {
  display: flex;
  justify-content: space-between;
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
}
.v {
  font-family: Menlo, monospace;
}
.link {
  display: block;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  text-align: center;
}
