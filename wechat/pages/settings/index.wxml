<view class="page">

  <text class="group">设备</text>
  <view class="list">
    <view wx:for="{{devices}}" wx:key="mac" class="item"><text>{{item.name}}</text><text class="dim mono">{{item.ip}}</text></view>
    <view class="item" data-url="/bci/pages/add/index" bindtap="go"><text>添加脑机接口</text><text class="chev">›</text></view>
  </view>

  <block wx:if="{{dev}}">
    <text class="group">开发</text>
    <view class="list">
      <view class="item" data-url="/pages/dev/index" bindtap="go"><text>设备直连验证</text><text class="chev">›</text></view>
    </view>
  </block>

  <text class="group">关于</text>
  <view class="list">
    <view class="item"><text>开源文明 BCI-001</text><text class="dim">数据只保存在这台手机上</text></view>
  </view>
</view>
