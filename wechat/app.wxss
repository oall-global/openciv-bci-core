/* The desktop app's look (src/tokens.css, design/design-language.md), dark: bg #0a0d0c, paper
   #111715, raised #18201d, line #232e2a, ink #e6eeea / #bfccc5 / #9aa9a2 / #83928b, accent #5fd3a4
   (fill #2b7a5c), warn #e7ae55, danger #ef7e66; numbers in a monospaced face. */
page {
  background: #0a0d0c;
  color: #e6eeea;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: 'PingFang SC', 'Microsoft YaHei UI', sans-serif;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
}
.mono {
  font-family: 'IBM Plex Mono', Menlo, Consolas, monospace;
}
.dim {
  color: #9aa9a2;
}
.h1 {
  font-size: 40rpx;
  font-weight: 700;
}
.h2 {
  font-size: 28rpx;
  font-weight: 700;
}
.title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}
.sub {
  margin-top: 8rpx;
  color: #9aa9a2;
  font-size: 26rpx;
  text-align: center;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1px solid #232e2a;
  border-radius: 24rpx;
  background: #111715;
}
button.primary {
  width: 100% !important;
  margin-top: 32rpx;
  border-radius: 20rpx;
  background: #2b7a5c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
button.secondary {
  width: 100% !important;
  margin-top: 20rpx;
  border: 1px solid #232e2a;
  border-radius: 20rpx;
  background: #18201d;
  color: #e6eeea;
  font-size: 28rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  margin-left: 12rpx;
  padding: 6rpx 18rpx;
  border: 1px solid #232e2a;
  border-radius: 40rpx;
  color: #9aa9a2;
  font-size: 22rpx;
}
.pill.on {
  border-color: #2b7a5c;
  color: #5fd3a4;
}
.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.55);
}
.sheet {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-height: 90vh;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 36rpx 36rpx 0 0;
  background: #111715;
}
